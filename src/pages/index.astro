---
import Base from '../layouts/Base.astro';
import { site, builds, stack, flow } from '../data/site';

const { github, linkedin, email } = site.links;

const buildsLd = {
  '@type': 'ItemList',
  name: 'Builds',
  itemListElement: builds.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'SoftwareSourceCode',
      name: b.name,
      description: b.what,
      codeRepository: b.href,
      author: { '@id': `${site.url}/#person` },
    },
  })),
};
---
<Base jsonLd={[buildsLd]}>
  <div class="wrap">
    <header class="hero">
      <h1>{site.first}<br />{site.last}</h1>
      <p class="role">{site.role}</p>
      <dl class="ledger" aria-label="How I decide">
        <dt>Chose</dt><dd><mark>Markdown files and working prototypes</mark></dd>
        <dt>Over</dt><dd><s class="over">Slide decks and <span style="white-space:nowrap">20-page</span> specs</s></dd>
        <dt>Because</dt><dd class="because">Humans and agents both work from them.</dd>
      </dl>
      <p class="links">
        {github && <a href={github}>GitHub</a>}
        {linkedin && <a href={linkedin}>LinkedIn</a>}
        {email && <a href={`mailto:${email}`}>Email</a>}
      </p>
    </header>

    <section class="section" aria-labelledby="stack">
      <h2 id="stack">Hands-on with</h2>
      <ul class="stack">
        {stack.map((s) => (
          <li>
            <h3>{s.name}</h3>
            <p>{s.line}</p>
            {s.docs && <p class="doc-link"><a href={s.docs.href}>{s.docs.label}</a></p>}
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="builds">
      <h2 id="builds">Builds</h2>
      <ul class="builds">
        {builds.map((b) => (
          <li>
            <a href={b.href}>
              <h3>{b.name}</h3>
              <div><p>{b.what}</p><small>{b.meta}</small></div>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="section" aria-labelledby="ai">
      <h2 id="ai">How I work with AI</h2>
      <div>
        <ol class="flow">
          {flow.map((f) => <li><h3>{f.step}</h3><p>{f.line}</p></li>)}
        </ol>
        <p class="flow-note">The skills are public: <a href={builds[0].href}>see them on GitHub</a>.</p>
      </div>
    </section>
  </div>
</Base>
