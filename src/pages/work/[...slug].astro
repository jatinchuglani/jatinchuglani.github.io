---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const entries = await getCollection('work', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={`${d.chose} over ${d.over}.`}>
  <article class="wrap case">
    <a class="back" href="/">Back</a>
    <h1>{d.title}</h1>
    <dl class="ledger">
      <dt>Chose</dt><dd><mark>{d.chose}</mark></dd>
      <dt>Over</dt><dd><s class="over">{d.over}</s></dd>
      <dt>Because</dt><dd class="because">{d.because}</dd>
    </dl>
    <p class="meta">{d.role}</p>
    <div class="prose"><Content /></div>
  </article>
</Base>
